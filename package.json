{
  "name": "conveno",
  "version": "0.0.0",
  "private": true,
  "description": "Vendor-neutral mesh for AI coding CLI sessions",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  },
