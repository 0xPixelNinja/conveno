  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "24.19.4",
    "tsdown": "0.23.7",
    "turbo": "2.11.13",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
