{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "inputs": ["scripts/generate.mjs", "$TURBO_ROOT$/brand/**"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["generate", "^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["generate", "^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["generate"],
      "outputs": []
    },
    "@conveno/e2e#build": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
