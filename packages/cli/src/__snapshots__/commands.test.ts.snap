exports[`init > reports a malformed config as an error and changes nothing 1`] = `
"x Could not plan changes for claude
  "hooks" in <tmp>/home/.claude/settings.json must be an object. Fix the file, then run the install again. Nothing was changed.
  fix  Fix the problem above, or run conveno init --cli <others> to leave claude out.
"
`;

exports[`init > with --yes backs up, writes files, records a manifest and notes the Codex trust step 1`] = `
"Looking for AI coding CLIs on this machine
  ✓ claude  Claude Code  2.1.4   ~/.claude.json
  ✓ codex   Codex        0.46.0  ~/.codex/config.toml

Conveno will change 4 files. Nothing else is touched.

  ~/.claude.json
    Register the "conveno" MCP server at user scope (conveno mcp --cli claude).
    run  claude mcp add --scope user conveno -- conveno mcp --cli claude
    @@ -1,3 +1,15 @@
     {
    -    "theme": "dark"
    +    "theme": "dark",
    +    "mcpServers": {
    +        "conveno": {
    +            "type": "stdio",
    +            "command": "conveno",
    +            "args": [
    +                "mcp",
    +                "--cli",
    +                "claude"
    +            ],
    +            "env": {}
    +        }
    +    }
     }

  ~/.claude/settings.json  (new file)
    Add SessionStart and UserPromptSubmit hooks that deliver Conveno messages to Claude Code.
    @@ -0,0 +1,26 @@
    +{
    +  "hooks": {
    +    "SessionStart": [
    +      {
    +        "hooks": [
    +          {
    +            "type": "command",
    +            "command": "conveno hook claude SessionStart",
    +            "timeout": 5
    +          }
    +        ]
    +      }
    +    ],
    +    "UserPromptSubmit": [
    +      {
    +        "hooks": [
    +          {
    +            "type": "command",
    +            "command": "conveno hook claude UserPromptSubmit",
    +            "timeout": 5
    +          }
    +        ]
    +      }
    +    ]
    +  }
    +}

  ~/.codex/config.toml  (new file)
    Add the "conveno" MCP server in Codex config (mcp_servers.conveno).
    run  codex mcp add conveno -- conveno mcp --cli codex
    @@ -0,0 +1,3 @@
    +[mcp_servers.conveno]
    +command = "conveno"
    +args = ["mcp", "--cli", "codex"]

  ~/.codex/hooks.json  (new file)
    Add SessionStart and UserPromptSubmit hooks that deliver Conveno messages on the next turn. Codex asks you to trust new hooks: review them with /hooks.
    @@ -0,0 +1,26 @@
    +{
    +  "hooks": {
    +    "SessionStart": [
    +      {
    +        "hooks": [
    +          {
    +            "type": "command",
    +            "command": "conveno hook codex SessionStart",
    +            "timeout": 2
    +          }
    +        ]
    +      }
    +    ],
    +    "UserPromptSubmit": [
    +      {
    +        "hooks": [
    +          {
    +            "type": "command",
    +            "command": "conveno hook codex UserPromptSubmit",
    +            "timeout": 2
    +          }
    +        ]
    +      }
    +    ]
    +  }
    +}

  Backups go to ~/.conveno-data/backups/<timestamp>/
  Undo any time with: conveno uninstall

  ✓ claude  configured
  ✓ codex   configured

✓ Done. Backups are in ~/.conveno-data/backups/2026-11-27T14-02-11. Restart open sessions so they pick up Conveno.
i Codex asks you to trust new hooks once: run /hooks inside Codex.
  Next: conveno status lists your sessions.
"
`;

exports[`status > groups sessions by repo and marks the orchestrator, against a real daemon 1`] = `
"✓ daemon up · 3 sessions

  /work/api
    SESSION       CLI  TIER       STATE  LAST SEEN
  ● claude@api-1  cl   next turn  idle   14:02:11   orchestrator
  ○ codex@api-1   cx   next turn  idle   14:02:11

  /work/docs
    SESSION          CLI  TIER   STATE  LAST SEEN
  ○ opencode@docs-1  oc   inbox  idle   14:02:11

