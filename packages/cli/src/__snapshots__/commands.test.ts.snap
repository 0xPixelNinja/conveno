// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`doctor > is green after init with a daemon up 1`] = `
"  ✓ daemon  running, 0 sessions

    CLI     NAME         VERSION  MCP  HOOKS  TIER       NOTE
  ✓ claude  Claude Code  2.1.4    yes  yes    next turn  delivered at the next prompt

2 ok, 0 warnings, 0 problems
"
`;

exports[`doctor > reports each CLI, the daemon and fixes when nothing is set up > stderr 1`] = `
"
! The Conveno daemon is not running.
  why  No Conveno daemon is listening at <tmp>/d.sock. Start convenod or enable autoStart.
  fix  Run conveno daemon start. It also starts when a CLI opens the Conveno MCP server.

! Claude Code is missing the MCP server and the hooks.
  fix  Run conveno init, then restart open Claude Code sessions.
"
`;

exports[`doctor > reports each CLI, the daemon and fixes when nothing is set up > stdout 1`] = `
"  ! daemon  not running

    CLI     NAME         VERSION  MCP  HOOKS  TIER       NOTE
  ! claude  Claude Code  2.1.4    no   no     next turn  not fully configured
  - codex   Codex                                        not found on PATH

0 ok, 2 warnings, 0 problems
"
`;

exports[`help, version, unknown > prints plain, short help 1`] = `
"c● conveno 0.0.0

Usage: conveno <command> [options]

  init [--yes] [--dry-run]  Set up Claude Code, Codex and OpenCode
    [--cli list]            Limit init to some CLIs
  uninstall [--yes]         Undo what init changed
  status                    List sessions by repo
  doctor                    Check each CLI and the daemon
  daemon start|stop|status  Manage the background daemon
  mcp --cli <cli>           MCP server on stdio (CLIs launch this)
  hook <cli> <event>        Hook entry (CLIs launch this)
  --version                 Print the version

--cli takes a comma-separated list such as claude,codex.
"
`;

exports[`help, version, unknown > rejects an unknown command with exit 2 and a fix 1`] = `
"x Unknown command "frobnicate"
  conveno 0.0.0 has: init, uninstall, status, doctor, daemon, mcp, hook.
  fix  Run conveno --help to see usage.
"
`;

exports[`init > --dry-run prints the plan and diffs, exits 0 and writes nothing 1`] = `
"Looking for AI coding CLIs on this machine
  ✓ claude  Claude Code  2.1.4  ~/.claude.json

Conveno would change 2 files. Nothing else is touched.

  ~/.claude.json  (new file)
    Register the "conveno" MCP server at user scope (conveno mcp --cli claude).
    run  claude mcp add --scope user conveno -- conveno mcp --cli claude
    @@ -0,0 +1,14 @@
    +{
    +  "mcpServers": {
    +    "conveno": {
    +      "type": "stdio",
    +      "command": "conveno",
    +      "args": [
    +        "mcp",
    +        "--cli",
    +        "claude"
    +      ],
    +      "env": {}
    +    }
    +  }
    +}

  ~/.claude/settings.json  (new file)
    Add SessionStart and UserPromptSubmit hooks that deliver Conveno messages to Claude Code.
    @@ -0,0 +1,26 @@
    +{
    +  "hooks": {
    +    "SessionStart": [
    +      {
    +        "hooks": [
    +          {
    +            "type": "command",
    +            "command": "conveno hook claude SessionStart",
    +            "timeout": 5
    +          }
    +        ]
    +      }
    +    ],
    +    "UserPromptSubmit": [
    +      {
    +        "hooks": [
    +          {
    +            "type": "command",
    +            "command": "conveno hook claude UserPromptSubmit",
    +            "timeout": 5
    +          }
    +        ]
    +      }
    +    ]
    +  }
    +}

i Dry run: nothing was written. Run conveno init to apply.
"
`;

exports[`init > prints the plan and exits 1 without a terminal or --yes, changing nothing > stderr 1`] = `
"x Needs a terminal to confirm
  No changes were made.
  fix  Run conveno init --yes to apply the changes shown above.
"
`;

