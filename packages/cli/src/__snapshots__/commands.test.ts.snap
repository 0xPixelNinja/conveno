    +        ]
    +      }
    +    ]
    +  }
    +}

  ~/.codex/config.toml  (new file)
    Add the "conveno" MCP server in Codex config (mcp_servers.conveno). It lets Codex call Conveno's own tools without asking each time (default_tools_approval_mode = "approve", this server only).
    @@ -0,0 +1,4 @@
    +[mcp_servers.conveno]
    +command = "conveno"
    +args = ["mcp", "--cli", "codex"]
    +default_tools_approval_mode = "approve"

  ~/.codex/hooks.json  (new file)
    Add SessionStart and UserPromptSubmit hooks that deliver Conveno messages on the next turn. Codex asks you to trust new hooks: review them with /hooks.
    @@ -0,0 +1,26 @@
    +{
    +  "hooks": {
