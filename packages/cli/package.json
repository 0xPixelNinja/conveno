{
  "name": "conveno",
  "version": "0.0.0",
  "private": true,
  "description": "The `conveno` command: init, status, doctor, uninstall, pair, login, logs",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "conveno": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@0xpixelninja/conveno-brand": "workspace:*"
  }
}
