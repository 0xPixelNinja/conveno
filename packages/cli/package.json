{
  "name": "@conveno/cli",
  "version": "0.1.1-rc.1",
  "description": "The conveno command: connect AI coding CLI sessions so they can message each other.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xPixelNinja/conveno.git",
    "directory": "packages/cli"
  },
  "homepage": "https://conveno.dev",
  "bugs": {
    "url": "https://github.com/0xPixelNinja/conveno/issues"
  },
  "keywords": [
    "conveno",
    "cli",
    "ai",
    "coding-agents",
    "mcp",
    "claude-code",
    "codex",
    "opencode"
  ],
  "type": "module",
  "bin": {
    "conveno": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "@conveno/adapter-claude": "workspace:*",
    "@conveno/adapter-codex": "workspace:*",
    "@conveno/adapter-opencode": "workspace:*",
    "@conveno/brand": "workspace:*",
    "@conveno/client": "workspace:*",
    "@conveno/core": "workspace:*",
    "@conveno/daemon": "workspace:*",
    "@conveno/mcp": "workspace:*",
    "@conveno/protocol": "workspace:*"
  }
}
