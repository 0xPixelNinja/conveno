{
  "name": "@conveno/cli",
  "version": "0.1.1-rc.2",
  "description": "Connect AI coding CLI sessions so they can message each other.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xPixelNinja/conveno.git",
    "directory": "packages/cli"
  },
  "homepage": "https://conveno.dev",
  "bugs": {
    "url": "https://github.com/0xPixelNinja/conveno/issues"
  },
  "keywords": [
    "conveno",
    "cli",
    "ai",
    "coding-agents",
    "mcp",
    "claude-code",
    "codex",
    "opencode"
  ],
  "type": "module",
  "bin": {
    "conveno": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "node ../../scripts/copy-legal.mjs"
  },
  "dependencies": {
    "@decimalturn/toml-patch": "3.3.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "jsonc-parser": "3.3.1",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@conveno/adapter-claude": "workspace:*",
    "@conveno/adapter-codex": "workspace:*",
    "@conveno/adapter-opencode": "workspace:*",
    "@conveno/brand": "workspace:*",
    "@conveno/client": "workspace:*",
    "@conveno/core": "workspace:*",
    "@conveno/daemon": "workspace:*",
    "@conveno/mcp": "workspace:*",
    "@conveno/protocol": "workspace:*"
  }
}
