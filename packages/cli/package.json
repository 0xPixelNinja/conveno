{
  "name": "conveno",
  "version": "0.0.0",
  "private": true,
  "description": "The `conveno` command: init, uninstall, status, doctor, daemon, mcp, hook",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xPixelNinja/conveno.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/0xPixelNinja/conveno#readme",
  "bugs": {
    "url": "https://github.com/0xPixelNinja/conveno/issues"
  },
  "type": "module",
  "bin": {
    "conveno": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@0xpixelninja/conveno-adapter-claude": "workspace:*",
    "@0xpixelninja/conveno-adapter-codex": "workspace:*",
    "@0xpixelninja/conveno-adapter-opencode": "workspace:*",
    "@0xpixelninja/conveno-brand": "workspace:*",
    "@0xpixelninja/conveno-client": "workspace:*",
    "@0xpixelninja/conveno-core": "workspace:*",
    "@0xpixelninja/conveno-daemon": "workspace:*",
    "@0xpixelninja/conveno-mcp": "workspace:*",
    "@0xpixelninja/conveno-protocol": "workspace:*"
  }
}
