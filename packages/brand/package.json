{
  "name": "@conveno/brand",
  "version": "0.1.1",
  "description": "Conveno brand tokens, terminal theme and icon names.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xPixelNinja/conveno.git",
    "directory": "packages/brand"
  },
  "homepage": "https://conveno.dev",
  "bugs": {
    "url": "https://github.com/0xPixelNinja/conveno/issues"
  },
  "keywords": [
    "conveno",
    "brand",
    "design-tokens",
    "terminal"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/generated/tokens.css",
    "./tokens.json": "./dist/generated/tokens.json",
    "./sprite.svg": "./dist/generated/sprite.svg"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsdown && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "node ../../scripts/copy-license.mjs"
  }
}
