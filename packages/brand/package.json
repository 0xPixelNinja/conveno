{
  "name": "@0xpixelninja/conveno-brand",
  "version": "0.0.0",
  "private": true,
  "description": "Conveno brand tokens, terminal theme and icon names, generated from brand/tokens.json",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/generated/tokens.css",
    "./tokens.json": "./dist/generated/tokens.json",
    "./sprite.svg": "./dist/generated/sprite.svg"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/generate.mjs && tsdown && node scripts/copy-assets.mjs",
    "typecheck": "node scripts/generate.mjs && tsc -p tsconfig.json",
    "test": "node scripts/generate.mjs && vitest run"
  }
}
