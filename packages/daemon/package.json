{
  "name": "@conveno/daemon",
  "version": "0.1.1-rc.3",
  "private": true,
  "description": "convenod, the local Conveno daemon: IPC server, SQLite store and process management.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xPixelNinja/conveno.git",
    "directory": "packages/daemon"
  },
  "homepage": "https://conveno.dev",
  "bugs": {
    "url": "https://github.com/0xPixelNinja/conveno/issues"
  },
  "keywords": [
    "conveno",
    "daemon",
    "sqlite",
    "ipc"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
