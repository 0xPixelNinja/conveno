{
  "name": "@conveno/core",
  "version": "0.1.1-rc.3",
  "private": true,
  "description": "Core library for Conveno: client interface, mailbox, naming, message formatting and data paths.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xPixelNinja/conveno.git",
    "directory": "packages/core"
  },
  "homepage": "https://conveno.dev",
  "bugs": {
    "url": "https://github.com/0xPixelNinja/conveno/issues"
  },
  "keywords": [
    "conveno",
    "core",
    "mailbox",
    "agents"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@conveno/protocol": "workspace:*",
    "zod": "4.6.7"
  }
}
